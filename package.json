{
  "name": "codex-claude-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A local Codex MCP bridge for permission-aware Claude Code tasks.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate": "noodle validate --json",
    "noodle:test": "noodle test --json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@noodleseed/one": "latest",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.1.2",
    "eslint": "^9.26.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.1.2"
  }
}
